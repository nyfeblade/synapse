# The box desktop's settings. Read by provision.sh, DisplayManager and vnc-bridge.
CAPTURE=ffmpeg
CHROMIUM_SANDBOX=on
VNC_TRANSPORT=unix
SHELL_ENV_HIDDEN=pass
SETPRIV_SAME_CGROUP=pass
PROFILE_SHARED_LIVE=no
COOKIE_COPY=pass
PER_SCREEN_MB=1726
MAX_SCREENS_RECOMMENDED=3
CHROMIUM_BIN=/usr/bin/chromium
WS_OVER_ROUTE=pass
