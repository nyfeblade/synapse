[Unit]
Description=Bots host (gateway, transcripts, supervisor)
After=network-online.target bots-auth-proxy.service
Wants=network-online.target
# Bug 364: fail closed. The host never runs without the box firewall (auth proxy rule + Mac guard).
Requires=bots-auth-proxy.service

[Service]
User=bothost
Group=bothost
WorkingDirectory=/opt/bothost/app
EnvironmentFile=-/etc/bothost.env
Environment=NODE_ENV=production
Environment=PROMPTS_DIR=/opt/bothost/app
ExecStart=/usr/local/bin/node /opt/bothost/app/host.mjs serve
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=6

[Install]
WantedBy=multi-user.target
