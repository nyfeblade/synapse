#!/usr/bin/env bash
# Two macOS accounts on one Mac (shared/src/user-ports.ts): the host's own ports, and the auth proxy's firewall rule
# (bug 117) moved with the proxy. One script, three callers: deploy streams it (`apply`, as root), provision installs it
# and renders the rule (`load`), and bots-auth-proxy.service runs `load` at every boot, so the loaded rule always
# follows the port in the host's drop-in. 47802 stays covered too, so a host still on it before its restart is never
# left open. The rule is loaded (nft -f replaces the table atomically) BEFORE the drop-in moves the host, and on every
# run, so a load that failed once is fixed by the next run. R/SYSTEMCTL/NFT exist for tests only.
set -euo pipefail
R="${R:-}"; SYSTEMCTL="${SYSTEMCTL:-systemctl}"; NFT="${NFT:-/usr/sbin/nft}"
DROPIN="$R/etc/systemd/system/bothost.service.d/20-ports.conf"
RULE="$R/etc/bots/auth-proxy.nft"
TEMPLATE="$R/etc/bots/auth-proxy.nft.in"
num() { case "$1" in ''|*[!0-9]*) echo "bots-ports: bad port '$1'" >&2; exit 2 ;; esac; }
rule() {
  local px="$1" src dp
  # A box provisioned before the template existed has only the rendered rule; the rewrite below is idempotent on it.
  if [ -f "$TEMPLATE" ]; then src="$TEMPLATE"; elif [ -f "$RULE" ]; then src="$RULE"
  else echo "bots-ports: the auth proxy's firewall rule is missing ($TEMPLATE); re-provision the Bots' computer" >&2; exit 1; fi
  if [ "$px" = 47802 ]; then dp="47802"; else dp="{ 47802, $px }"; fi
  sed -E "s/dport (\{[^}]*\}|[0-9]+)/dport $dp/" "$src" > "$RULE.new"
  mv "$RULE.new" "$RULE"
  sh -c "$NFT -f '$RULE'"
}
case "${1:-}" in
  apply)
    gw="${2:-}"; wh="${3:-}"; px="${4:-}"
    num "$gw"; num "$wh"; num "$px"
    rule "$px"
    install -d -m 0755 "$(dirname "$DROPIN")"
    printf '[Service]\nEnvironment=HOST_PORT=%s\nEnvironment=WEBHOOK_PORT=%s\nEnvironment=SYNAPSE_AUTH_PROXY_PORT=%s\n' "$gw" "$wh" "$px" > "$DROPIN.new"
    mv "$DROPIN.new" "$DROPIN"
    sh -c "$SYSTEMCTL daemon-reload"
    echo "ports: gateway $gw, webhook $wh, auth proxy $px"
    ;;
  load)
    px=""
    if [ -f "$DROPIN" ]; then px="$(sed -n 's/^Environment=SYNAPSE_AUTH_PROXY_PORT=//p' "$DROPIN" | tail -n 1)"; fi
    px="${px:-47802}"
    num "$px"
    rule "$px"
    ;;
  *) echo "usage: bots-ports apply GATEWAY WEBHOOK AUTH_PROXY | bots-ports load" >&2; exit 2 ;;
esac
