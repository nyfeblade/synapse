#!/bin/sh
# CMP-10: `bot-wallpaper paint :N <tone>` sets the root window of display :N. `bot-wallpaper generate` makes the five images.
set -eu
W=/usr/local/share/bots/wallpapers
case "${1:-}" in
  generate)
    mkdir -p "$W"
    mk() { convert -size 1280x800 "gradient:$2-$3" -distort SRT "$4" \( -size 1280x800 xc: +noise Random -blur 0x60 -colorspace Gray -level 45%,55% \) \
             -compose SoftLight -composite -blur 0x2 "$W/$1.png"; }
    mk dawn    '#f7f7f7' '#dcdcdc' 18
    mk day     '#fbfbfb' '#e6e6e6' 24
    mk dusk    '#e9e9e9' '#c6c6c6' 32
    mk evening '#5a5a5a' '#2e2e2e' 20
    mk night   '#3a3a3a' '#141414' 28 ;;
  paint)
    d="$2"; t="$3"
    # Bug 292: the tones were renamed; an older host still sends the old ids, painted as the same tone.
    case "$t" in light-day) t=dawn;; light-noon) t=day;; light-night) t=dusk;; dark-day) t=evening;; dark-noon) t=night;; esac
    case "$t" in dawn|day|dusk|evening|night) ;; *) echo "bad tone" >&2; exit 2;; esac
    DISPLAY="$d" display -window root -resize '1280x800!' "$W/$t.png" ;;
  *) echo "usage: bot-wallpaper generate | paint :N <tone>" >&2; exit 2 ;;
esac
